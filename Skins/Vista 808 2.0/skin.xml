<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<skin>
  <info>
    <author>Ki Shodar and erisune</author>
    <website>http://ki-shodar.deviantart.com</website>
  </info>

  <osds>
    <volume background="OSD\back.png" mask="OSD\glass.png" defaultUnits="15">
      <meter type="bitstrip" image="OSD\meter.png" units="15" x="14" y="16"/>
      <meter type="text" width="100" height="100" x="33" y="16" color="000000" font="Segoe UI" size="10.5" align="center" transparency="255" format="[[PERC]]" glow="12"/>
      <iconset location="Icons\Volume"/>
    </volume>
    <mute background="OSD\mute.png" mask="OSD\glass.png"/>
    <eject background="OSD\eject.png" mask="OSD\glass.png">
      <meter type="text" width="100" height="100" x="33" y="105" color="000000" font="Segoe UI" size="8.75" align="center" transparency="255" format="DRIVE EJECT" glow="12"/>
    </eject>
  </osds>

  <sliders>
    <volume background="Slider\back.png" mask="Slider\glass.png">
      <slider type="horizontal" image="Slider\knob.png"
              x="17" y="9" width="115" height="6"/>
    </volume>
  </sliders>
</skin>